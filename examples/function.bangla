// function example
শুরু

// যোগ করার function
কাজ যোগ(ক, খ) {
  ফেরত দাও ক + খ;
}

// গুণ করার function
কাজ গুণ(ক, খ) {
  ফেরত দাও ক * খ;
}

// নাম দিয়ে সালাম
কাজ সালাম(নাম) {
  দেখাও "হ্যালো " + নাম;
}

ধরো ফলাফল = যোগ(10, 20);
দেখাও "যোগফল:";
দেখাও ফলাফল;

ধরো গুণফল = গুণ(5, 6);
দেখাও "গুণফল:";
দেখাও গুণফল;

করো সালাম("তানজিদ");

শেষ