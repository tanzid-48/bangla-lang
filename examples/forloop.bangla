// for loop example
শুরু

দেখাও "১ থেকে ৫ পর্যন্ত গণনা:";
গণনা করো (ধরো ক = 1; ক <= 5; ক = ক + 1) {
  দেখাও ক;
}

দেখাও "জোড় সংখ্যা:";
গণনা করো (ধরো ক = 2; ক <= 10; ক = ক + 2) {
  দেখাও ক;
}

দেখাও "ভাগশেষ test:";
গণনা করো (ধরো ক = 1; ক <= 10; ক = ক + 1) {
  যদি (ক % 2 == 0) {
    দেখাও ক;
  }
}

শেষ